###############################################################################
# CONTOH KONFIGURASI — SALIN KE .env LALU ISI SESUAI MESIN ANDA
#   cp .env.example .env
#   php artisan key:generate
# JANGAN PERNAH commit .env yang sudah terisi (sudah masuk .gitignore).
###############################################################################

APP_NAME="LombaKampus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale Indonesia (Panduan: tampilkan tanggal dalam format lokal)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Password hashing — 12 rounds adalah nilai minimum yang wajar untuk PBF
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# DATABASE — PostgreSQL (Panduan §6.4: timestamptz + zona waktu eksplisit)
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lomba_kampus_dev
DB_USERNAME=lomba_app
DB_PASSWORD=lomba_dev_password

# Database terpisah untuk menjalankan test suite (php artisan test)
DB_TEST_DATABASE=lomba_kampus_test

# Zona waktu aplikasi. Semua kolom waktu disimpan sebagai TIMESTAMPTZ,
#값 ini hanya mengubah cara nilai itu ditampilkan ke pengguna.
APP_TIMEZONE=Asia/Jakarta

###############################################################################
# SESSION & CACHE
# Cookie session wajib HttpOnly + SameSite. Secure otomatis saat APP_URL https
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Nilai Redis dibiarkan kosong — proyek ini tidak memakai Redis.
# Kalau filled tidak sengaja, hapus blok ini.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# MAIL — default memakai driver log (tidak mengirim apa pun).
# Demo tidak boleh mengirim email sungguhan. Untuk production, ganti ke smtp
# hanya pada server, JANGAN pernah menaruh kredensial SMTP di repo.
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lokakampus.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# STORAGE — bukti organisasi disimpan DI LUAR webroot (Panduan §8).
# Disini hanya nilai non-rahasia; kredensial S3/Flysystem production
# dipasang lewat environment server, bukan di file ini.
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# CAPTCHA (opsional, hanya untuk production)
# Token WAJIB diverifikasi di backend — jangan percaya skor dari frontend.
# Kosongkan di local supaya alur moderasi tetap bisa diuji tanpa layanan luar.
###############################################################################
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=